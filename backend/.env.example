# ─────────────────────────────────────────────────────────────────────────────
#  Backend environment template. Copy to `.env` and fill in real values.
#  NEVER commit the real .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (MySQL / Aiven) ---
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# --- Server ---
PORT=5001
NODE_ENV=development

# --- Auth ---
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# --- CORS ---
# Comma-separated list of allowed front-end origins.
# Defaults to the local Vite dev servers if left blank.
CORS_ORIGINS=http://localhost:5173

# --- Email (SMTP) for password-reset OTPs ---
# Example (Gmail): host=smtp.gmail.com port=587 user=<address> pass=<app-password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LNMIIT Exam Portal <no-reply@lnmiit.ac.in>
