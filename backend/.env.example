# ─────────────────────────────────────────────────────────────────────────────
#  Backend environment template. Copy to `.env` and fill in real values.
#  NEVER commit the real .env — it holds DB credentials + the JWT secret.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (MySQL) ---
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# TLS to the DB. Leave unset/true for managed clouds (Aiven etc.) that REQUIRE
# TLS. Set to `false` for a plain on-prem / college LAN MySQL with no TLS,
# otherwise the connection handshake will fail.
DB_SSL=true

# --- Server ---
PORT=5001
# Use `production` on the deployed server (hides error stack traces in responses).
NODE_ENV=production

# --- Auth ---
# Long random string. Generate with: openssl rand -hex 32
# Changing this invalidates all existing logins (everyone must sign in again).
JWT_SECRET=

# --- CORS ---
# Comma-separated list of allowed front-end origins (scheme + host + port).
# When the frontend is served same-origin behind a reverse proxy that also
# proxies /api, the browser sends no Origin header and this is not strictly
# needed — but set it to the public URL anyway. Example:
#   CORS_ORIGINS=https://exams.college.edu
CORS_ORIGINS=http://localhost:5173

# --- Email (SMTP) for password-reset OTPs (OPTIONAL) ---
# If left blank, OTP emails are stubbed/logged instead of sent — login + the rest
# of the app work fine without SMTP. Example (Gmail): host=smtp.gmail.com port=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=College Exam Portal <no-reply@college.edu>
